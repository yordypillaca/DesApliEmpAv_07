<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="DB"
         connectionString="Server=ALDAIR\SQLEXPRESS;Database=BibliotecaDB;Integrated Security=True;TrustServerCertificate=True;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="MultaPorDia" value="1.50" />
    <add key="MaxLibrosPendientes" value="3" />
  </appSettings>
</configuration>
