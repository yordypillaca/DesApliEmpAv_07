<Page x:Class="Biblioteca.WPF.Views.DevolucionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Devolución">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Registrar devolución" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <ui:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Fecha de devolución" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="dpDevolucion" Style="{StaticResource FormDate}"
                                SelectedDateChanged="dpDevolucion_SelectedDateChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="txtDetalle" Text="Seleccione un libro pendiente." Style="{StaticResource HintText}" />
                    <TextBlock x:Name="txtMulta" Text="Multa: —" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" />
                </StackPanel>
                <ui:Button x:Name="btnRegistrar" Grid.Column="3" Content="Registrar devolución"
                           Appearance="Primary" Icon="{ui:SymbolIcon CheckmarkCircle24}"
                           VerticalAlignment="Bottom" Click="btnRegistrar_Click" />
            </Grid>
        </ui:Card>

        <ui:Card Grid.Row="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <DataGrid x:Name="dgPendientes" Style="{StaticResource ModernGrid}"
                          SelectionChanged="dgPendientes_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="2*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="3*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="120"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Días" Binding="{Binding DiasRetraso}" Width="70"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTextColumn Header="Multa (S/)" Binding="{Binding Multa, StringFormat={}{0:0.00}}" Width="110"
                                            ElementStyle="{StaticResource NumberCell}" />
                        <DataGridTemplateColumn Header="Situación" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EstadoPill}">
                                        <TextBlock Style="{StaticResource EstadoPillText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="emptyState" Style="{StaticResource EmptyState}">
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No hay libros pendientes de devolución." Margin="0,10,0,0"
                               HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                </StackPanel>
                <ui:ProgressRing x:Name="busyRing" IsIndeterminate="True"
                                 Width="48" Height="48" Visibility="Collapsed" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
