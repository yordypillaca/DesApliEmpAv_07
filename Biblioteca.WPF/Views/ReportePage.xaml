<Page x:Class="Biblioteca.WPF.Views.ReportePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Reporte">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Préstamos por fecha" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <ui:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Desde" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="dpDesde" Style="{StaticResource FormDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hasta" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="dpHasta" Style="{StaticResource FormDate}" />
                </StackPanel>
                <ui:Button x:Name="btnConsultar" Grid.Column="4" Content="Consultar" Appearance="Primary"
                           Icon="{ui:SymbolIcon Search24}" VerticalAlignment="Bottom" Click="btnConsultar_Click" />
                <TextBlock x:Name="txtResumen" Grid.Column="5" Margin="16,0,0,8" VerticalAlignment="Bottom"
                           Style="{StaticResource HintText}" />
            </Grid>
        </ui:Card>

        <ui:Card Grid.Row="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Grid>
                <DataGrid x:Name="dgReporte" Style="{StaticResource ModernGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="2*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="3*"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Préstamo" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}" Width="120"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="130"
                                            ElementStyle="{StaticResource TextCell}" />
                        <DataGridTemplateColumn Header="Estado" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource EstadoPill}">
                                        <TextBlock Style="{StaticResource EstadoPillText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="emptyState" Style="{StaticResource EmptyState}">
                    <ui:SymbolIcon Symbol="DocumentTable24" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="txtEmpty" Text="No hay préstamos en ese intervalo." Margin="0,10,0,0"
                               HorizontalAlignment="Center" Style="{StaticResource HintText}" />
                </StackPanel>
                <ui:ProgressRing x:Name="busyRing" IsIndeterminate="True"
                                 Width="48" Height="48" Visibility="Collapsed" />
            </Grid>
        </ui:Card>
    </Grid>
</Page>
