<Page x:Class="Biblioteca.WPF.Views.PrestamoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Préstamo">
    <Grid Margin="32,20,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Registrar préstamo" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <ui:Card Grid.Row="1" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Socio" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <Grid>
                        <ComboBox x:Name="cboSocio" Style="{StaticResource FormCombo}"
                                  DisplayMemberPath="Etiqueta" SelectedValuePath="SocioId"
                                  SelectionChanged="cboSocio_SelectionChanged" />
                        <TextBlock Text="Seleccione un socio">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource ComboHint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=cboSocio}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="txtPendientes" Margin="0,8,0,0" Style="{StaticResource HintText}"
                               Text="Seleccione un socio." />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fecha de préstamo" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="dpPrestamo" Style="{StaticResource FormDate}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Fecha límite" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                    <DatePicker x:Name="dpLimite" Style="{StaticResource FormDate}" />
                </StackPanel>
            </Grid>
        </ui:Card>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Card Grid.Column="0" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Libros disponibles" Style="{StaticResource SectionTitle}" />
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <ComboBox x:Name="cboLibro" Style="{StaticResource FormCombo}"
                                      DisplayMemberPath="Etiqueta" />
                            <TextBlock Text="Seleccione un libro">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource ComboHint}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=cboLibro}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ui:Button x:Name="btnAgregar" Grid.Column="1" Margin="8,0,0,0" Content="Agregar"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Click="btnAgregar_Click" />
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Libros de este préstamo" Style="{StaticResource SectionTitle}" />
                    <DataGrid x:Name="dgCarrito" Grid.Row="1" Margin="0,12,0,12" Style="{StaticResource ModernGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"
                                                ElementStyle="{StaticResource TextCell}" />
                            <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="140"
                                                ElementStyle="{StaticResource TextCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="btnQuitar" Grid.Column="0" Content="Quitar" HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon Dismiss24}" Click="btnQuitar_Click" />
                        <ui:Button x:Name="btnRegistrar" Grid.Column="2" Content="Registrar" HorizontalAlignment="Stretch"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Click="btnRegistrar_Click" />
                    </Grid>
                    <ui:ProgressRing x:Name="busyRing" Grid.Row="1" IsIndeterminate="True"
                                     Width="48" Height="48" Visibility="Collapsed" />
                </Grid>
            </ui:Card>
        </Grid>
    </Grid>
</Page>
